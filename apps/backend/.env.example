# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Authentication configuration
# AUTH_MODE: 'none' (no auth), 'simple' (username/password), 'oauth' (OAuth 2.0)
AUTH_MODE=none

# Simple auth credentials (required when AUTH_MODE=simple)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# OAuth configuration (required when AUTH_MODE=oauth)
OAUTH_CLIENT_ID=sardeenz
OAUTH_CLIENT_SECRET=change-me-in-production
OAUTH_ISSUER_URL=
K8S_API_URL=
# Kubernetes namespace where sardeenz is deployed (for RBAC checks)
NAMESPACE=sardeenz
# ServiceAccount token for RBAC checks (required when AUTH_MODE=oauth)
# In K8s: auto-mounted at /var/run/secrets/kubernetes.io/serviceaccount/token
# For dev: generate with: oc create token sardeenz -n sardeenz --duration=8760h
SERVICE_ACCOUNT_TOKEN=

# JWT configuration
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=8

# API base URL (for OAuth callbacks)
API_BASE_URL=http://localhost:3000

# Frontend URL for OAuth redirects in dev (defaults to API_BASE_URL)
# Set to http://localhost:5173 for development with Vite
FRONTEND_URL=http://localhost:5173

# Inference API key (optional)
# When set, inference endpoints (/v1/*, /api/direct/*) require this key
# via Authorization: Bearer <key> header (OpenAI API compatible)
# Admin JWT auth is NOT required for inference when this is set
# Leave empty to allow unauthenticated access to inference endpoints
INFERENCE_API_KEY=

# vLLM configuration
VLLM_BASE_PORT=12346
VLLM_MAX_INSTANCES=10
# Model startup timeout in ms (default 30 min, increase for slow downloads)
VLLM_STARTUP_TIMEOUT=1800000

# kvcached configuration
ENABLE_KVCACHED=true
KVCACHED_AUTOPATCH=true

# Local models configuration
# Path to directory containing pre-downloaded models
# Leave empty to disable local model browsing
# Example: /models or /mnt/pvc/models
LOCAL_MODELS_PATH=

# Logging
LOG_LEVEL=info
# Enable verbose streaming debug logs (SSE request/response/chunks)
# Set to 'true' to debug SSE streaming issues in production/OpenShift
DEBUG_STREAMING=false

# HuggingFace authentication (for gated models)
# Get your token from: https://huggingface.co/settings/tokens
# Can also be set via the Settings page in the web UI
HF_TOKEN=

# Virtual GPU mode (development only)
# Creates N virtual GPUs for testing multi-GPU features with single GPU hardware
# All virtual GPUs map to physical GPU 0
# Set to 0 (default) to disable, or 2+ to enable virtual GPUs
# Example: DEV_VIRTUAL_GPU_COUNT=2 npm run dev -w apps/backend
DEV_VIRTUAL_GPU_COUNT=0
