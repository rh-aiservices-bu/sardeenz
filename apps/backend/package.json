{
  "name": "@sardeenz/backend",
  "version": "0.1.0",
  "description": "Backend server for Sardeenz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/start-dev.sh",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "dredd",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/oauth2": "^8.1.0",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@sardeenz/types": "*",
    "@sardeenz/utils": "*",
    "@sinclair/typebox": "^0.34.9",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-metrics": "^12.1.0",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^2.1.8",
    "dredd": "^14.1.0",
    "eslint": "^9.39.1",
    "globals": "^14.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.48.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
